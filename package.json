{
  "name": "ryouya-note",
  "version": "2.1.0",
  "private": true,
  "description": "猟野ノート: 熊本県の猟場向けの狩猟用地図アプリ(PWA と iPhone アプリ)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build-web.mjs",
